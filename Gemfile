source "https://rubygems.org"

# Pins Jekyll and every plugin to exactly what GitHub Pages builds with, so a
# local `bundle exec jekyll serve` matches production. Versions it resolves to:
# https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins

# jekyll-feed, jekyll-sitemap and jekyll-seo-tag ship inside github-pages --
# they only need enabling in _config.yml, not declaring here.

# Dropped from the Ruby stdlib in 3.0; `jekyll serve` needs it to boot.
gem "webrick", "~> 1.8"
